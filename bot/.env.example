NETWORK=testnet
PROGRAM_ID=obscura_v5.aleo
ENDPOINT=https://api.explorer.provable.com/v1
POLL_INTERVAL=30000
# Comma-separated auction IDs to monitor (or "all" to scan mappings)
WATCH_AUCTIONS=all
# Alert when Dutch price drops below this (in ALEO, e.g. 0.5)
DUTCH_PRICE_THRESHOLD=0.5
# Alert when sealed-bid deadline is within this many blocks
DEADLINE_WARNING_BLOCKS=100
