    "zero-knowledge",
    "cli",
    "obscura"
  ],
  "author": "Obscura",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ritik200238/obscura-auction.git"
  },
  "homepage": "https://obscura-auction-95hm.vercel.app",
  "dependencies": {
    "obscura-aleo-sdk": "^0.6.0"
  },
  "devDependencies": {
    "@types/node": "^24.12.0",
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
